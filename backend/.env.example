# Copy to .env and fill in. Never ship these keys in the desktop app.
ANTHROPIC_API_KEY=
# Only needed if your API key isn't scoped to a workspace (the API returns a 400 saying so).
# ANTHROPIC_WORKSPACE_ID=
# Optional: without it the app still works, you just type your answers.
ASSEMBLYAI_API_KEY=

# Optional overrides
# INTERVIEW_MODEL=claude-opus-5-5
# INTERVIEW_TURN_EFFORT=low
# INTERVIEW_REPORT_EFFORT=medium
# ASSEMBLYAI_SPEECH_MODEL=universal-3-6-pro
# PORT=8787
